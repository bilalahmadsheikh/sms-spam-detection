import nltk
import string
import re
import pandas as pd
import os
import tkinter as tk
from tkinter import messagebox, scrolledtext, LabelFrame
from nltk.corpus import stopwords
from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline, FeatureUnion
from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.feature_extraction.text import CountVectorizer, TfidfTransformer, TfidfVectorizer
from sklearn.naive_bayes import MultinomialNB
from sklearn.metrics import accuracy_score, classification_report

# Download stopwords
nltk.download('stopwords')
stop_words = set(stopwords.words('english'))

# Text Preprocessor
def process_text(text):
    text = re.sub(r'\d+', '', text)  # Remove digits
    nopunc = ''.join([char for char in text if char not in string.punctuation])
    return [word for word in nopunc.split() if word.lower() not in stop_words]

# Keyword presence features
class KeywordFeatures(BaseEstimator, TransformerMixin):
    def __init__(self):
        self.keywords = ['click', 'win', 'free', 'urgent', 'offer', 'limited', 'now', 'cash', 'prize', 'buy']

    def fit(self, X, y=None):
        return self

    def transform(self, X):
        return pd.DataFrame([
            [1 if kw in text.lower() else 0 for kw in self.keywords] for text in X
        ])

# Model training function
def load_and_train_model():
    file_path = os.path.join(os.getcwd(), 'spam.csv')
    try:
        df = pd.read_csv(file_path, encoding='latin-1')[['v1', 'v2']]
        df.columns = ['class', 'text']
    except Exception as e:
        messagebox.showerror("File Error", str(e))
        return None, None, None

    X_train, X_test, y_train, y_test = train_test_split(df['text'], df['class'], test_size=0.2, random_state=42)

    pipeline = Pipeline([
        ('features', FeatureUnion([
            ('cleaned', Pipeline([
                ('vect', CountVectorizer(analyzer=process_text)),
                ('tfidf', TfidfTransformer())
            ])),
            ('ngrams', TfidfVectorizer(stop_words='english', ngram_range=(1, 2), max_features=5000)),
            ('keywords', KeywordFeatures())
        ])),
        ('classifier', MultinomialNB())
    ])

    pipeline.fit(X_train, y_train)
    y_pred = pipeline.predict(X_test)
    accuracy = accuracy_score(y_test, y_pred)
    report = classification_report(y_test, y_pred, output_dict=True)
    return pipeline, accuracy, report

# Predict message category
