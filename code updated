# Background animation utilities
def rgb_to_hex(rgb):
    return "#%02x%02x%02x" % rgb

def animate_background():
    global color_index, step
    r1, g1, b1 = color_palette[color_index % len(color_palette)]
    r2, g2, b2 = color_palette[(color_index + 1) % len(color_palette)]
    r = int(r1 + (r2 - r1) * step / steps)
    g = int(g1 + (g2 - g1) * step / steps)
    b = int(b1 + (b2 - b1) * step / steps)
    hex_color = rgb_to_hex((r, g, b))
    app.configure(bg=hex_color)
    for widget in app.winfo_children():
        try:
            widget.configure(bg=hex_color)
        except:
            pass
    step += 1
    if step > steps:
        step = 0
        color_index += 1
    app.after(50, animate_background)

# Background colors
